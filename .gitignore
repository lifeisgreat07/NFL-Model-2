__pycache__/
*.pyc
.pytest_cache/

# Local backtest output. Platform-specific (see the Model Lab reproducibility
# finding) -- must not be committed over the canonical numbers.
results/backtest_metrics.csv
results/qb_shrink_k_*.csv
results/*_run.log

# Throwaway repos built by src/booth_fixture_runner.py.
.fixture-run/

# Scratch PR description. src/scout_preflight.py takes a body_file, so the
# body gets written to disk before every PR; this is the conventional name for
# it. It is a draft of a GitHub artifact, not a repository artifact -- and the
# repo has already been bitten once by treating those two as the same thing
# (fixing a code comment does not fix a PR description).
.pr-body.md

# Scratch commit message; PowerShell has no heredocs, so git commit -F needs a file.
.commit-msg.txt

# Build outputs. Both are produced by src/generate_dashboard.py and were
# tracked until Stage 8c phase 2. Tracking a generated file meant every branch
# that touched the template collided with whatever CI had regenerated on main
# -- five conflicts in one day across three branches -- and neither file has a
# meaningful diff to review: both carry a build stamp (the "Data as of" footer,
# and reportlab's /CreationDate, /ModDate and derived /ID), so a no-op rebuild
# still rewrites them.
#
# GitHub Pages now serves a CI-built artifact rather than the committed copy,
# so nothing reads these from the repository. The root conftest.py builds them
# for the test session. Leading slashes: only the ones at the repository root,
# never a src/dist/ or similar further down.
/index.html
/dist/
