__pycache__/
*.pyc
.pytest_cache/

# Local backtest output. Platform-specific (see the Model Lab reproducibility
# finding) -- must not be committed over the canonical numbers.
results/backtest_metrics.csv
results/qb_shrink_k_*.csv
results/*_run.log

# Throwaway repos built by src/agents/booth_fixture_runner.py.
.fixture-run/

# Scratch PR description. src/agents/scout_preflight.py takes a body_file, so the
# body gets written to disk before every PR; this is the conventional name for
# it. It is a draft of a GitHub artifact, not a repository artifact -- and the
# repo has already been bitten once by treating those two as the same thing
# (fixing a code comment does not fix a PR description).
.pr-body.md

# Scratch commit message; PowerShell has no heredocs, so git commit -F needs a file.
.commit-msg.txt

# Build outputs. Both are produced by src/pipeline/generate_dashboard.py and were
# tracked until Stage 8c phase 2. Tracking a generated file meant every branch
# that touched the template collided with whatever CI had regenerated on main
# -- five conflicts in one day across three branches -- and neither file has a
# meaningful diff to review: both carry a build stamp (the "Data as of" footer,
# and reportlab's /CreationDate, /ModDate and derived /ID), so a no-op rebuild
# still rewrites them.
#
# GitHub Pages now serves a CI-built artifact rather than the committed copy,
# so nothing reads these from the repository. The root conftest.py builds them
# for the test session. Leading slashes: only the ones at the repository root,
# never a src/dist/ or similar further down.
/index.html
/dist/
CLAUDE.local.md 

# A temporary file src/pipeline/atomic_write.py writes beside its target and swaps in.
# A run killed before the swap leaves one behind, sometimes in a committed
# folder; it must never be committed (Stage 30 item 8).
*.tmp

# Editor backups beside the dashboard's parts. read_template() refuses any
# file in src/dashboard/ that page.html does not include, on purpose (a
# stray file would be a part someone believes is on the page), so keep the
# usual backup names from ever being committed there (Stage 36, Q8).
src/dashboard/*~
src/dashboard/*.bak
src/dashboard/*.orig
src/dashboard/*.swp

# The scheduled jobs' recent runs, written by the deploy job only
# (src/pipeline/recent_runs.py) and never committed.
data/recent_runs.json
# Written by src/pipeline/picks_csv.py for the site build (Stage 46 item 7).
/picks.csv
# Written by src/pipeline/lock_proof.py in the site build (Stage 46 item 5).
data/lock_proof.json
