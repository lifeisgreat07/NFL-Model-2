  {
   "id": "sheets-nhl-literal-duration",
   "why": "the rows' chevron turns in a literal .15s that reduced motion cannot reach.",
   "find": "  .game-row-chev{color:var(--text-3); transition:transform var(--dur-base) var(--ease);}",
   "replace": "  .game-row-chev{color:var(--text-3); transition:transform .15s;}",
   "expect_caught_by": "test_every_duration_is_a_token"
  }
 ]
