   "find": "    if decision.lock:\n",
   "replace": "    if False:\n",
   "expect_caught_by": "test_the_nba_daily_run_end_to_end"
  },
  {
   "id": "e2e-nba-page-inputs-raw-timestamp",
   "target": "src/sports/nba/page_inputs.py",
