{
 "target": "src/sports/nhl/pages/nhl.js",
 "tests": "tests/test_nhl_ratings_row.py",
 "cases": [
  {
   "id": "nhl-ratings-plain-table",
   "why": "the NHL's Ratings goes back to a plain number (Stage 79 item 47, V8).",
   "find": "${r.teams.map((t, i) => ratingRowHtml(t, i, scale)).join('')}",
   "replace": "${r.teams.map((t, i) => `<tr><td class=\"num\">${i + 1}</td><td>${escapeHtml(t.team)}</td><td class=\"num\">${signed(t.goal, 2)}</td><td class=\"num\">${signed(t.shot, 1)}</td></tr>`).join('')}",
   "expect_caught_by": "test_the_page_draws_its_clubs_with_them"
  },
  {
   "id": "nhl-ratings-bar-from-the-edge",
   "why": "the bar grows from the left edge, not the zero line.",
   "find": "left:${t.goal >= 0 ? 50 : 50 - w / 2}%; width:${w / 2}%;",
   "replace": "left:0%; width:${w}%;",
   "expect_caught_by": "test_the_bar_grows_from_the_zero_line_against_the_leagues_largest"
  },
  {
   "id": "nhl-ratings-no-scale",
   "why": "the header stops printing the scale, so a full bar means nothing.",
   "find": "<span class=\"ax-min\">${signed(-scale, 2)}</span><span class=\"ax-zero\">0</span><span class=\"ax-max\">${signed(scale, 2)}</span>",
   "replace": "<span class=\"ax-zero\">0</span>",
   "expect_caught_by": "test_the_header_prints_the_scale"
  },
  {
   "id": "nhl-ratings-broken-logo",
   "why": "a club with no logo gets an image with an empty source.",
   "find": "const img = src ? `<img class=\"team-logo\" src=\"${src}\"",
   "replace": "const img = true ? `<img class=\"team-logo\" src=\"${src}\"",
   "expect_caught_by": "test_the_bar_grows_from_the_zero_line_against_the_leagues_largest"
  }
 ]
}
