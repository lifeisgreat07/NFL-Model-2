{
 "target": "src/sports/nba/pages/nba.js",
 "tests": "tests/test_nba_tip_time.py",
 "cases": [
  {
   "id": "nba-tip-flag-ignored",
   "why": "a game ESPN says has no time set prints its placeholder hour (Stage 77 item 33, as corrected 2026-10-15).",
   "find": "  return Boolean(g.start) && g.tv !== false;\n",
   "replace": "  return Boolean(g.start);\n",
   "expect_caught_by": "test_only_espns_false_reads_tbd"
  },
  {
   "id": "nba-tip-missing-flag-reads-tbd",
   "why": "a game with no flag (a schedule file from before the field) reads time TBD everywhere.",
   "find": "  return Boolean(g.start) && g.tv !== false;\n",
   "replace": "  return Boolean(g.start) && g.tv === true;\n",
   "expect_caught_by": "test_only_espns_false_reads_tbd"
  },
  {
   "id": "nba-tip-row-prints-anyway",
   "why": "the row prints the hour while the card says time TBD.",
   "find": "  return tipSet(g) ? FMT_HOUR.format(new Date(g.start)) : 'time TBD';\n",
   "replace": "  return FMT_HOUR.format(new Date(g.start));\n",
   "expect_caught_by": "test_the_row_the_card_and_the_note_all_use_it"
  },
  {
   "id": "nba-tip-card-prints-anyway",
   "why": "the card's date line prints the hour while the row says time TBD.",
   "find": "  return tipSet(g) ? `${day} · ${FMT_TIME.format(new Date(g.start))}${startMark()}` : `${day} · time TBD`;\n",
   "replace": "  return `${day} · ${FMT_TIME.format(new Date(g.start))}${startMark()}`;\n",
   "expect_caught_by": "test_the_row_the_card_and_the_note_all_use_it"
  },
  {
   "id": "nba-tip-schedule-drops-flag",
   "target": "src/sports/nba/schedule.py",
   "why": "the schedule no longer keeps ESPN's flag, so every time is printed.",
   "find": "            'time_valid': comp['timeValid'] if isinstance(comp.get('timeValid'), bool) else None,\n",
   "replace": "            'time_valid': None,\n",
   "expect_caught_by": "test_the_schedule_keeps_espns_flag"
  },
  {
   "id": "nba-tip-file-drops-flag",
   "target": "src/sports/nba/page_inputs.py",
   "why": "the daily run's schedule file leaves the flag out, so the board never sees it.",
   "find": "                   'home_score', 'away_score', 'neutral_site', 'time_valid')",
   "replace": "                   'home_score', 'away_score', 'neutral_site')",
   "expect_caught_by": "test_the_schedule_file_and_the_board_carry_it"
  },
  {
   "id": "nba-tip-board-drops-flag",
   "target": "src/sports/nba/site.py",
   "why": "the board's game data leaves the flag out.",
   "find": "            'tv': g.get('time_valid')}",
   "replace": "            }",
   "expect_caught_by": "test_the_schedule_file_and_the_board_carry_it"
  },
  {
   "id": "nba-tip-home-drops-unset",
   "target": "src/site/home.py",
   "why": "the home page is never told which starts are not set.",
   "find": "if g.get('game_type') in game_types and g.get('start_utc') and g.get('time_valid') is False})",
   "replace": "if False})",
   "expect_caught_by": "test_the_home_page_lists_the_unset_starts"
  },
  {
   "id": "nba-tip-home-ignores-unset",
   "target": "src/site/home/home.js",
   "why": "the home page prints a time ESPN says is not set.",
   "find": "function tipSet(t){ return !UNSET_TIPS.has(t); }",
   "replace": "function tipSet(t){ return true; }",
   "expect_caught_by": "test_the_home_page_reads_them_the_same_way"
  },
  {
   "id": "nba-tip-home-card-plain-time",
   "target": "src/site/home/home.js",
   "why": "the home page's NBA card before its first pick prints the first tip's hour whatever ESPN says.",
   "find": "[['First tip-off', tipWhen(first)]]",
   "replace": "[['First tip-off', when(first)]]",
   "expect_caught_by": "test_the_home_page_reads_them_the_same_way"
  },
  {
   "id": "nba-tip-check-unwired",
   "target": ".github/workflows/browser-checks.yml",
   "why": "the NBA tip time browser check is dropped from CI.",
   "find": "        run: python tests/browser/check_nba_tip.py \"$RUNNER_TEMP/states/nba.html\"\n",
   "replace": "        run: echo skipped\n",
   "expect_caught_by": "test_the_browser_check_runs"
  }
 ]
}
