{
  "target": "src/pipeline/generate_dashboard.py",
  "tests": "tests/test_generated_data_reaches_the_page.py",
  "cases": [
    {
      "id": "builder-reads-nhl-unbridged",
      "why": "the builder starts reading the NHL's folders while the NHL daily run is still not bridged to it, so the NHL's page would go stale after every run.",
      "find": "from __future__ import annotations\n",
      "replace": "from __future__ import annotations\nNHL_DATA = 'data/nhl'\n",
      "expect_caught_by": "test_a_writer_not_yet_on_a_page_feeds_no_page_and_writes_only_its_own_folders"
    }
  ]
}
