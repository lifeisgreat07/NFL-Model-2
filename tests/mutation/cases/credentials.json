{
  "target": "src/core/credentials.py",
  "tests": "tests/test_credentials.py",
  "cases": [
    {
      "id": "credentials-warn-a-day-late",
      "why": "the warning starts at 29 days instead of 30, one day later than the register and the alert title promise",
      "find": "        if left <= WARN_DAYS:\n",
      "replace": "        if left < WARN_DAYS:\n",
      "expect_caught_by": "test_a_credential_warns_from_30_days_out_and_not_before"
    },
    {
      "id": "credentials-expired-goes-quiet",
      "why": "a credential already past its date stops warning, so the alert ends on the day the runs start failing",
      "find": "        if left <= WARN_DAYS:\n",
      "replace": "        if 0 <= left <= WARN_DAYS:\n",
      "expect_caught_by": "test_an_expired_credential_keeps_warning"
    },
    {
      "id": "credentials-entry-without-basis",
      "why": "an entry with no date or no account of where the date came from is accepted, so a guessed expiry reads as a known one",
      "find": "        if missing:\n            raise CredentialsError(f'{row.get(\"name\", \"?\")}: missing {missing}')\n",
      "replace": "",
      "expect_caught_by": "test_an_entry_missing_a_field_is_refused"
    },
    {
      "id": "credentials-oauth-token-unregistered",
      "target": ".github/credentials.json",
      "why": "the token every agent runs on drops out of the register, so its expiry is checked by nothing",
      "find": "      \"name\": \"CLAUDE_CODE_OAUTH_TOKEN\",\n",
      "replace": "      \"name\": \"AGENT_TOKEN\",\n",
      "expect_caught_by": "test_every_secret_a_workflow_reads_is_registered"
    },
    {
      "id": "credentials-checked-on-no-day",
      "target": ".github/workflows/nightly-dependency-audit.yml",
      "why": "the weekday gate matches no day, so the check never runs and no credential ever warns",
      "find": "          if [ \"$(date -u +%u)\" != \"1\" ]; then\n",
      "replace": "          if [ \"$(date -u +%u)\" != \"8\" ]; then\n",
      "expect_caught_by": "test_the_nightly_audit_checks_it_on_mondays_and_alerts"
    }
  ]
}
