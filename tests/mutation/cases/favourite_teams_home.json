{
 "target": "src/site/home/home.js",
 "tests": "tests/test_favourite_teams.py",
 "cases": [
  {
   "id": "yours-any-day",
   "why": "tomorrow's games are named as tonight's.",
   "find": "&& dayKey(t) === dayKey(now) && t > now - 3 * HOUR;",
   "replace": "&& t > now - 3 * HOUR;",
   "expect_caught_by": "test_the_home_names_your_teams_games_tonight"
  },
  {
   "id": "yours-everyone",
   "why": "every game is named, starred or not.",
   "find": "return (list.includes(r.a) || list.includes(r.h)) &&",
   "replace": "return true &&",
   "expect_caught_by": "test_nothing_is_named_before_a_team_is_starred_or_on_a_day_without_their_games"
  },
  {
   "id": "yours-bad-list",
   "why": "a damaged list throws.",
   "find": "const list = Array.isArray(favs[r.s]) ? favs[r.s] : [];",
   "replace": "const list = favs[r.s] || [];",
   "expect_caught_by": "test_nothing_is_named_before_a_team_is_starred_or_on_a_day_without_their_games"
  },
  {
   "id": "yours-wrong-key",
   "why": "the home reads its own key, so a star on a sport page never reaches it.",
   "find": "localStorage.getItem('site:favs')",
   "replace": "localStorage.getItem('home:favs')",
   "expect_caught_by": "test_the_home_has_a_place_for_it_and_reads_the_shared_list"
  }
 ]
}
