{
  "target": "src/sports/ncaam/backtest.py",
  "tests": "tests/test_ncaam_backtest.py",
  "cases": [
    {
      "id": "ncaam-curve-fitted-on-its-own-day",
      "why": "a day's curve is fitted on that day's results too, so the tuning scores forecasts that have seen their answers.",
      "find": "train = table[table['day'] < day]",
      "replace": "train = table[table['day'] <= day]",
      "expect_caught_by": "test_a_days_curve_is_fitted_only_on_earlier_days"
    },
    {
      "id": "ncaam-tuning-tie-to-the-later-entry",
      "why": "equal log losses go to the later grid entry, not the earlier one the registration names.",
      "find": "best = min(results, key=lambda r: r['log_loss'])",
      "replace": "best = min(reversed(results), key=lambda r: r['log_loss'])",
      "expect_caught_by": "test_tuning_searches_the_whole_grid_and_a_tie_goes_to_the_earlier_entry"
    },
    {
      "id": "ncaam-unchecked-season-used",
      "why": "a season that has not passed the fallback check is read anyway.",
      "find": "    if unchecked:\n",
      "replace": "    if False:\n",
      "expect_caught_by": "test_a_season_that_has_not_passed_the_fallback_check_is_not_used"
    },
    {
      "id": "ncaam-tuning-run-again",
      "why": "the tuning runs over a result already on file, so it can be repeated until it reads well.",
      "find": "    if (RESULTS / 'tuning.json').exists():\n",
      "replace": "    if False:\n",
      "expect_caught_by": "test_the_tuning_is_written_once"
    },
    {
      "id": "ncaam-validation-seasons-shifted",
      "why": "a tournament's season is taken to be its own year, so the tuning reads 2019-20 and misses 2014-15.",
      "find": "return [t - 1 for t in reg['protocol']['validation_tournaments']]",
      "replace": "return [t for t in reg['protocol']['validation_tournaments']]",
      "expect_caught_by": "test_the_validation_seasons_are_the_registered_tournaments_seasons"
    }
  ]
}
