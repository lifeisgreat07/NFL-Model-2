{
  "target": ".github/workflows/nhl-daily.yml",
  "tests": "tests/test_generated_data_reaches_the_page.py",
  "cases": [
    {
      "id": "nhl-daily-commits-all-data",
      "why": "the NHL daily run commits the whole data folder, so it writes what the NFL page reads while no page rebuild follows it.",
      "find": "          git add data/nhl predictions/nhl results/nhl\n",
      "replace": "          git add data predictions/nhl results/nhl\n",
      "expect_caught_by": "test_a_writer_not_yet_on_a_page_feeds_no_page_and_writes_only_its_own_folders"
    }
  ]
}
