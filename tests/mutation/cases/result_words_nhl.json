{
 "target": "src/sports/nhl/pages/nhl.js",
 "tests": "tests/test_result_words.py",
 "cases": [
  {
   "id": "result-words-nhl-line",
   "why": "the NHL card's result line says right/wrong under rows that say Correct/Missed.",
   "find": "<b>${s === won ? 'correct' : 'missed'}</b>",
   "replace": "<b>${s === won ? 'right' : 'wrong'}</b>",
   "expect_caught_by": "test_every_result_label_says_correct_or_missed"
  },
  {
   "id": "result-words-nhl-table",
   "why": "the NHL's calibration table heads its column Right.",
   "find": "class=\"num\">Said, on average</th><th scope=\"col\" class=\"num\">Correct</th>",
   "replace": "class=\"num\">Said, on average</th><th scope=\"col\" class=\"num\">Right</th>",
   "expect_caught_by": "test_no_label_says_right_or_wrong"
  },
  {
   "id": "result-words-nhl-day-summary",
   "why": "the NHL day summary says \"1 of 3 right so far\" above rows that say Correct.",
   "find": ", ${right} of ${graded.length} correct so far`;",
   "replace": ", ${right} of ${graded.length} right so far`;",
   "expect_caught_by": "test_every_result_label_says_correct_or_missed"
  }
 ]
}
