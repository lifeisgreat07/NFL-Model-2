{
  "target": ".github/workflows/booth-pr-audit.yml",
  "tests": "tests/test_action_pins.py",
  "cases": [
    {
      "id": "booth-back-on-a-movable-tag",
      "why": "the audit workflow goes back to @v1: whoever can move that tag decides what code reads every PR with this repository's token, and nothing in a diff here would show the change",
      "find": "uses: anthropics/claude-code-action@8ce9314fa9a404564fa7e954cd84f25bcba2b829 # v1.0.236",
      "replace": "uses: anthropics/claude-code-action@v1",
      "expect_caught_by": "test_each_is_pinned_to_a_full_commit_sha"
    },
    {
      "id": "auto-commit-pinned-to-a-short-sha",
      "target": ".github/workflows/weekly-update.yml",
      "why": "a seven-character SHA looks pinned and is not a full commit id; GitHub resolves only full SHAs as immutable",
      "find": "uses: stefanzweifel/git-auto-commit-action@b863ae1933cb653a53c021fe36dbb774e1fb9403 # v5.2.0",
      "replace": "uses: stefanzweifel/git-auto-commit-action@b863ae1 # v5.2.0",
      "expect_caught_by": "test_each_is_pinned_to_a_full_commit_sha"
    },
    {
      "id": "a-pin-without-its-version",
      "target": ".github/workflows/collect-agent-log.yml",
      "why": "the SHA is right but nothing says which release it is, so the next update has to look it up, and a reader cannot tell a current pin from a two-year-old one",
      "find": "uses: stefanzweifel/git-auto-commit-action@b863ae1933cb653a53c021fe36dbb774e1fb9403 # v5.2.0",
      "replace": "uses: stefanzweifel/git-auto-commit-action@b863ae1933cb653a53c021fe36dbb774e1fb9403",
      "expect_caught_by": "test_each_pin_says_which_release_it_is"
    },
    {
      "id": "an-update-that-stopped-halfway",
      "target": ".github/workflows/weekend-refresh.yml",
      "why": "one workflow moves to a different commit of the action and the others do not, so the same step behaves differently depending on which workflow ran it",
      "find": "uses: stefanzweifel/git-auto-commit-action@b863ae1933cb653a53c021fe36dbb774e1fb9403 # v5.2.0",
      "replace": "uses: stefanzweifel/git-auto-commit-action@0000000000000000000000000000000000000000 # v5.1.0",
      "expect_caught_by": "test_one_major_of_an_action_is_one_sha_everywhere"
    },
    {
      "id": "checkout-back-on-a-movable-tag",
      "target": ".github/workflows/deploy-pages.yml",
      "why": "the job that publishes the site checks out with @v4 again: the first step of the job, with its token in reach, is whatever that tag points at today",
      "find": "uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0",
      "replace": "uses: actions/checkout@v4",
      "expect_caught_by": "test_each_is_pinned_to_a_full_commit_sha"
    },
    {
      "id": "a-workflow-drops-out-of-the-count",
      "target": ".github/workflows/run-tests.yml",
      "why": "setup-python is reached by another spelling the scan does not match, so one use goes unchecked and the pins guard says nothing about it",
      "find": "uses: actions/setup-python@",
      "replace": "uses: ./actions/setup-python@",
      "expect_caught_by": "test_the_scan_finds_every_use_of_the_pinned_actions"
    },
    {
      "id": "deploy-pages-back-on-a-movable-tag",
      "target": ".github/workflows/deploy-pages.yml",
      "why": "the step that publishes the site, holding pages: write and id-token: write, runs whatever @v4 points at today",
      "find": "uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4.0.5",
      "replace": "uses: actions/deploy-pages@v4",
      "expect_caught_by": "test_each_is_pinned_to_a_full_commit_sha"
    },
    {
      "id": "a-new-action-arrives-on-a-tag",
      "target": ".github/workflows/run-tests.yml",
      "why": "a workflow gains an action no list names, on a movable tag; a scan that checks only the listed actions would pass it",
      "find": "uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0",
      "replace": "uses: actions/github-script@v7",
      "expect_caught_by": "test_every_action_in_every_workflow_is_on_the_list"
    }
  ]
}
