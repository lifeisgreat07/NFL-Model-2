      "replace": "const OVERFLOW_PAGES = ['teamdive','method','modellab','reliability'];",
      "expect_caught_by": "test_the_more_button_list_is_the_sheet"
    },
    {
      "id": "more-button-names-a-folded-page",
      "why": "a page that no longer exists is listed, which is how the list rotted the first time",
      "find": "const OVERFLOW_PAGES = ['teamdive','method','changelog','modellab','reliability'];",
      "replace": "const OVERFLOW_PAGES = ['teamdive','method','changelog','modellab','reliability','glossary'];",
