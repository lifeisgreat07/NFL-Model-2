{
  "target": "src/core/forward_test.py",
  "tests": "tests/test_audit7_disclosures.py",
  "cases": [
    {
      "id": "forward-file-without-its-market",
      "why": "the forward-test file stops saying which price its market is, so a reader takes the lock-time line for the backtest's closing one",
      "find": "        'market_price': MARKET_PRICE,\n",
      "replace": "",
      "expect_caught_by": "test_the_forward_file_names_its_market"
    },
    {
      "id": "nhl-page-forgets-the-market",
      "target": "src/sports/nhl/pages/nhl.js",
      "why": "the NHL's checks page prints 'the market' with no word of which price it is",
      "find": "${f.market_price ? ' ' + f.market_price.said : ''}",
      "replace": "",
      "expect_caught_by": "test_both_pages_print_it_beside_the_forward_test"
    }
  ]
}
