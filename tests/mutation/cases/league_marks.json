      "replace": "  return `<span class=\"lgm\" aria-hidden=\"true\">${img('500', 'lgm-l')}`\n",
      "expect_caught_by": "test_each_card_mark_is_hot_linked_in_both_themes_with_our_icon_behind_it"
    },
    {
      "id": "league-mark-no-fallback-listener",
      "why": "a mark that fails to load is never noticed, so a refused image leaves an empty box where the sport's icon was.",
      "find": "  if(box) box.classList.add('lgm-failed');\n",
      "replace": "",
      "expect_caught_by": "test_a_mark_that_fails_falls_back_and_the_theme_shows_one_version"
    },
    {
      "id": "league-mark-failed-hides-our-icon",
