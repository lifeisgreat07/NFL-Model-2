      "replace": "<nav class=\"sport-switch sport-strip\" aria-label=\"Sports\"><a href=\"../\">Home</a><a href=\"../nfl/\"><span class=\"lgm lgm-sm\" aria-hidden=\"true\"><img class=\"lgm-l\" src=\"https://a.espncdn.com/combiner/i?img=/i/teamlogos/leagues/500/nfl.png&amp;w=36&amp;h=36\" alt=\"\" width=\"16\" height=\"16\">",
      "expect_caught_by": "test_every_sport_pages_switchers_carry_the_marks_and_hide_a_failed_one"
