      "why": "a card whose mark failed hides the mark and never shows our icon, so the card's sport goes unmarked.",
      "find": ".lgm.lgm-failed .lgm-own{ display:inline-flex; }\n",
      "replace": "",
      "expect_caught_by": "test_a_mark_that_fails_falls_back_and_the_theme_shows_one_version"
    },
    {
      "id": "league-mark-no-light-theme",
      "target": "src/dashboard/styles.css",
      "why": "the light theme never swaps to the light mark, so every page shows the dark-background mark on white.",
      "find": "  [data-theme=\"light\"] .lgm .lgm-l{display:block;}\n",
      "replace": "",
      "expect_caught_by": "test_a_mark_that_fails_falls_back_and_the_theme_shows_one_version"
    },
    {
      "id": "league-mark-sidebar-loose",
      "target": "src/dashboard/styles.css",
