  },
  {
   "id": "nhl-eyebrow-next-week-unnamed",
   "why": "the week after this one reads Coming Up, so the board never says Next Week.",
   "find": "  if(week === dayIso(next)) return 'Next Week';\n",
   "replace": "",
   "expect_caught_by": "test_the_eyebrow_says_which_week_it_is"
  },
  {
   "id": "nhl-eyebrow-past-reads-coming",
   "why": "a past week reads Coming Up.",
   "find": "  return week > thisWeek ? 'Coming Up' : 'Earlier';\n",
   "replace": "  return 'Coming Up';\n",
   "expect_caught_by": "test_the_eyebrow_says_which_week_it_is"
  },
  {
   "id": "nhl-eyebrow-check-unwired",
   "target": ".github/workflows/browser-checks.yml",
   "why": "the NHL eyebrow browser check is dropped from CI.",
   "find": "        run: python tests/browser/check_nhl_eyebrow.py \"$RUNNER_TEMP/states/nhl.html\"\n",
   "replace": "        run: echo skipped\n",
   "expect_caught_by": "test_the_browser_check_runs"
  }
 ]
