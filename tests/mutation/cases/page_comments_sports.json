{
  "target": "src/sports/nhl/site.py",
  "tests": "tests/test_page_comments.py",
  "cases": [
    {
      "id": "strip-nhl-page-unstripped",
      "why": "the NHL's page is filled without the shared renderer's finish, so it ships its templates' comments",
      "find": "    return page_render.finish(page_render.assemble(TEMPLATE, SHARED_PARTS),\n",
      "replace": "    return page_render.fill(page_render.assemble(TEMPLATE, SHARED_PARTS),\n",
      "expect_caught_by": "test_every_other_page_is_stripped_before_its_fills"
    }
  ]
}
