{
  "target": "src/dashboard/styles.css",
  "tests": "tests/test_sidebar_scroll.py",
  "cases": [
    {
      "id": "sidebar-list-does-not-scroll",
      "why": "the tab list loses its scrolling, so in a laptop window the last tabs sit below the window's edge again.",
      "find": "flex:0 1 auto; min-height:132px; overflow-y:auto; overscroll-behavior:contain;",
      "replace": "flex:0 1 auto; min-height:132px;",
      "expect_caught_by": "test_the_tab_list_scrolls_and_its_items_keep_their_height"
    },
    {
      "id": "sidebar-buttons-squeezed",
      "why": "the tab buttons may shrink, so a short window flattens them instead of scrolling the list.",
      "find": "  nav.side-nav > *{flex-shrink:0;}\n",
      "replace": "  nav.side-nav > *{flex-shrink:1;}\n",
      "expect_caught_by": "test_the_tab_list_scrolls_and_its_items_keep_their_height"
    },
    {
      "id": "sidebar-never-scrolls-whole",
      "why": "the sidebar itself cannot scroll, so a window too short for the foot hides the theme button.",
      "find": "    overflow-y:auto; overscroll-behavior:contain;\n  }\n  .brand{",
      "replace": "  }\n  .brand{",
      "expect_caught_by": "test_the_whole_sidebar_scrolls_in_a_window_too_short_for_the_list_to_absorb"
    },
    {
      "id": "sidebar-more-mark-takes-clicks",
      "why": "the more mark catches the pointer, so the tab under it cannot be clicked.",
      "find": "margin-top:-34px; pointer-events:none;",
      "replace": "margin-top:-34px;",
      "expect_caught_by": "test_the_more_mark_never_takes_a_click_and_adds_no_height"
    }
  ]
}
