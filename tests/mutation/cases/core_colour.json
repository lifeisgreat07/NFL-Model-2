{
  "target": "src/core/colour.py",
  "tests": "tests/test_nhl_colours.py",
  "cases": [
    {
      "id": "core-colour-luminance-weights",
      "why": "the luminance weights are swapped for red and green, so every contrast ratio is wrong.",
      "find": "    return 0.2126 * r + 0.7152 * g + 0.0722 * b",
      "replace": "    return 0.7152 * r + 0.2126 * g + 0.0722 * b",
      "expect_caught_by": "test_wcag_contrast_has_its_known_end_points"
    },
    {
      "id": "core-colour-one-cvd-type",
      "why": "only protanopia is simulated, so pairs only deuteranopes confuse pass.",
      "find": "    return min(ciede2000(rgb_to_lab(simulate(a, k)), rgb_to_lab(simulate(b, k))) for k in MACHADO)",
      "replace": "    return ciede2000(rgb_to_lab(simulate(a, 'protanopia')), rgb_to_lab(simulate(b, 'protanopia')))",
      "expect_caught_by": "test_the_core_method_is_the_one_the_nfl_palette_was_measured_with"
    },
    {
      "id": "core-colour-hex-unchecked",
      "why": "a short hex string is read as a colour.",
      "find": "    if len(h) != 6:",
      "replace": "    if False:",
      "expect_caught_by": "test_wcag_contrast_has_its_known_end_points"
    },
    {
      "id": "core-colour-push-backwards",
      "why": "the push lightens the away colour and darkens the home one, so the core no longer measures what the board draws.",
      "find": "    return shade(a, -push), shade(h, push)",
      "replace": "    return shade(a, push), shade(h, -push)",
      "expect_caught_by": "test_the_core_push_is_the_boards_push"
    }
  ]
}
