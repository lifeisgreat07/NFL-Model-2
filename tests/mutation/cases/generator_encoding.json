{
  "target": "src/pipeline/generate_dashboard.py",
  "tests": "tests/test_generator_encoding.py",
  "cases": [
    {
      "id": "generator-writes-the-page-in-the-local-encoding",
      "why": "index.html is written in the platform default again, so a Windows build crashes on a character outside cp1252 and otherwise writes different bytes from CI",
      "find": "    with open(OUTPUT_PATH, 'w', encoding='utf-8') as f:",
      "replace": "    with open(OUTPUT_PATH, 'w') as f:",
      "expect_caught_by": "test_every_open_names_utf8"
    },
    {
      "id": "generator-reads-the-template-in-the-local-encoding",
      "why": "the template is read in the platform default, so its non-ASCII text is decoded as cp1252 on Windows",
      "find": "    with open(TEMPLATE_PATH, encoding='utf-8') as f:",
      "replace": "    with open(TEMPLATE_PATH) as f:",
      "expect_caught_by": "test_every_open_names_utf8"
    }
  ]
}
