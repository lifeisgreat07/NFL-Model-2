{
 "target": "src/sports/nba/pages/nba.js",
 "tests": "tests/test_nba_lab_glyph.py",
 "cases": [
  {
   "id": "nba-lab-bold-label",
   "why": "the NBA's decisions go back to bold text where the NFL shows a pill (Stage 79 item 51, B4).",
   "find": "<span class=\"lab-tags\"><span class=\"conf-tag tag-neutral\">${escapeHtml(q.label)}</span></span>",
   "replace": "<b>${q.label}</b>",
   "expect_caught_by": "test_each_question_shows_the_glyph_and_its_decision_as_a_pill"
  },
  {
   "id": "nba-lab-glyph-dropped",
   "why": "the NBA's intervals are figures only again.",
   "find": "<span class=\"lab-lead\">${intervalGlyph(q.diff, q.low, q.high)}</span>",
   "replace": "",
   "expect_caught_by": "test_each_question_shows_the_glyph_and_its_decision_as_a_pill"
  },
  {
   "id": "nba-lab-column-headed-label",
   "why": "the NBA's decision column is headed Label again where the NFL's says Decision (audit 9 D10).",
   "find": "<th scope=\"col\" class=\"num\">Interval</th><th scope=\"col\">Decision</th>",
   "replace": "<th scope=\"col\" class=\"num\">Interval</th><th scope=\"col\">Label</th>",
   "expect_caught_by": "test_every_model_labs_decision_column_is_headed_decision"
  }
 ]
}
