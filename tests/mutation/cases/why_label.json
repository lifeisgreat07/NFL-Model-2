{
  "target": "src/dashboard/app.js",
  "tests": "tests/test_why_words.py",
  "cases": [
    {
      "id": "why-label-dropped",
      "why": "the sentence goes back to sitting unlabelled under Model B's headline, so on a split card 'MIA are ahead here' reads as contradicting 'KC 86% to win'.",
      "find": "  return words ? `<div class=\"why-by\">Model A&#39;s reasoning</div>${words}` : '';",
      "replace": "  return words;",
      "expect_caught_by": "test_the_sentence_is_labelled_as_model_as_reasoning"
    },
    {
      "id": "why-label-over-nothing",
      "why": "a card with no recorded contributions still draws 'Model A's reasoning' over no reason at all.",
      "find": "  return words ? `<div class=\"why-by\">Model A&#39;s reasoning</div>${words}` : '';",
      "replace": "  return `<div class=\"why-by\">Model A&#39;s reasoning</div>${words}`;",
      "expect_caught_by": "test_no_sentence_means_no_label"
    },
    {
      "id": "board-draws-the-unlabelled-sentence",
      "why": "the label exists but the board never calls it, so the card is unchanged.",
      "find": "    const whyHtml = g.why ? `\n      ${whyLabelled(g)}",
      "replace": "    const whyHtml = g.why ? `\n      ${whySentence(g)}",
      "expect_caught_by": "test_the_board_draws_the_labelled_sentence"
    },
    {
      "id": "why-label-shares-a-class",
      "why": "the label takes .why-label, the class the numbers panel's row labels already wear, so its rule restyles those rows too.",
      "find": "  return words ? `<div class=\"why-by\">Model A&#39;s reasoning</div>${words}` : '';",
      "replace": "  return words ? `<div class=\"why-label\">Model A&#39;s reasoning</div>${words}` : '';",
      "expect_caught_by": "test_the_labels_class_is_its_own"
    }
  ]
}
