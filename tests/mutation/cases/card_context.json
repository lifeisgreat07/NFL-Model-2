{
  "target": "src/dashboard_template.html",
  "tests": "tests/test_card_context.py",
  "cases": [
    {
      "id": "tv-pill-outlives-the-game",
      "why": "the channel stays on a final or graded card, where 'where to watch' is history.",
      "find": "  if(!g.tv || g.graded || g.status === 'final') return '';",
      "replace": "  if(!g.tv) return '';",
      "expect_caught_by": "test_the_channel_leaves_once_the_game_is_over"
    },
    {
      "id": "tv-regional-note-on-every-week",
      "why": "the regional line shows whenever any channel is on screen, so a week of national games says its games are regional.",
      "find": "  return games.some(g => cardTvPill(g) !== '' && g.tv_regional);",
      "replace": "  return games.some(g => cardTvPill(g) !== '');",
      "expect_caught_by": "test_the_regional_line_appears_only_with_a_regional_game_on_screen"
    },
    {
      "id": "tv-held-back-channel-shown",
      "target": "src/generate_dashboard.py",
      "why": "the card reads nfl.com's raw list instead of the checked networks, so a channel that failed a check reaches the page.",
      "find": "        network = (tv.get('networks') or [None])[0]",
      "replace": "        network = (tv.get('listed') or [None])[0]",
      "expect_caught_by": "test_a_held_back_channel_never_reaches_the_page"
    },
    {
      "id": "tv-regional-flag-ignores-territory",
      "target": "src/generate_dashboard.py",
      "why": "every shown channel is flagged regional, so the regional line appears on a national-only week.",
      "find": "            'tv_regional': bool(network) and tv.get('territory') == 'REGIONAL',",
      "replace": "            'tv_regional': bool(network),",
      "expect_caught_by": "test_a_held_back_channel_never_reaches_the_page"
    },
    {
      "id": "qb-line-flips-sides",
      "why": "the home quarterback is named first under an away-first matchup header, pairing each name with the wrong team.",
      "find": "  return `Quarterbacks: ${side(g.away, g.away_qb, g.away_qb_basis)} \u00b7 ${side(g.home, g.home_qb, g.home_qb_basis)}`;",
      "replace": "  return `Quarterbacks: ${side(g.away, g.home_qb, g.home_qb_basis)} \u00b7 ${side(g.home, g.away_qb, g.away_qb_basis)}`;",
      "expect_caught_by": "test_quarterbacks_are_away_first_like_the_card"
    },
    {
      "id": "qb-fallback-not-said",
      "why": "a quarterback the pick only assumed from last game reads as the announced starter.",
      "find": "      + (basis === 'last_game' ? ' (assumed: none listed yet, so last game&#39;s starter)' : '');",
      "replace": "      + '';",
      "expect_caught_by": "test_a_fallback_quarterback_is_said_to_be_assumed"
    },
    {
      "id": "qb-names-dropped",
      "target": "src/generate_dashboard.py",
      "why": "the saved quarterbacks never reach the page, so the card never names them.",
      "find": "            'away_qb': p.get('away_qb'), 'home_qb': p.get('home_qb'),",
      "replace": "            'away_qb': None, 'home_qb': None,",
      "expect_caught_by": "test_the_quarterbacks_reach_the_page"
    },
    {
      "id": "news-picks-qb-not-first",
      "why": "the pick's own quarterback listed doubtful is reported as an ordinary starter, after 'new QB', instead of leading the line.",
      "find": "  if(qbListed) bits.push(`QB ${qb.name} ${qbListed}`);\n  else if",
      "replace": "  if(false) bits.push(`QB ${qb.name} ${qbListed}`);\n  else if",
      "expect_caught_by": "test_the_picks_quarterback_on_the_report_leads_the_line"
    },
    {
      "id": "news-list-grows-past-two",
      "why": "every starter is named, so a bad injury week turns the one line into a paragraph.",
      "find": "  if(others.length > 2) bits.push",
      "replace": "  if(others.length > 99) bits.push",
      "expect_caught_by": "test_more_than_two_starters_become_a_count"
    },
    {
      "id": "news-quiet-game-gets-a-label",
      "why": "a game with nothing to report still draws 'Team news' and nothing after it.",
      "find": "  return parts.length ? `<b>Team news</b> ${parts.map(cardEsc).join(' \u00b7 ')}` : '';",
      "replace": "  return `<b>Team news</b> ${parts.map(cardEsc).join(' \u00b7 ')}`;",
      "expect_caught_by": "test_no_news_is_no_line"
    },
    {
      "id": "news-outlives-the-game",
      "why": "injury news stays on a final card, where it no longer bears on anything.",
      "find": "  if(!news || !news.teams || g.graded || g.status === 'final') return '';",
      "replace": "  if(!news || !news.teams) return '';",
      "expect_caught_by": "test_news_leaves_the_card_once_the_game_is_over"
    },
    {
      "id": "news-names-not-escaped",
      "why": "a name from the injury report is written into the page as markup.",
      "find": "${parts.map(cardEsc).join(' \u00b7 ')}` : '';",
      "replace": "${parts.join(' \u00b7 ')}` : '';",
      "expect_caught_by": "test_names_are_escaped"
    }
  ]
}
