{
  "target": "tests/mutation/runner.py",
  "tests": "tests/test_nightly_mutation.py",
  "cases": [
    {
      "id": "rotation-skips-the-sports",
      "why": "the rotation runs only src/core, and every guard of a sport's own code is left to the random slice again",
      "find": "ROTATED = ('src/core/', 'src/sports/')\n",
      "replace": "ROTATED = ('src/core/',)\n",
      "expect_caught_by": "test_every_core_and_sport_python_case_comes_up_in_thirty_nights"
    },
    {
      "id": "rotation-slot-by-day-of-month",
      "why": "the slot is the day of the month, so in a 31-day month one share of the cases is skipped for a month",
      "find": "    slot = datetime.datetime.strptime(str(seed), '%Y%m%d').date().toordinal() % ROTATION_DAYS\n",
      "replace": "    slot = (datetime.datetime.strptime(str(seed), '%Y%m%d').date().day - 1) % ROTATION_DAYS\n",
      "expect_caught_by": "test_every_core_and_sport_python_case_comes_up_in_thirty_nights"
    }
  ]
}
