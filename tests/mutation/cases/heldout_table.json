      "find": "<td class=\"num\">${v.log_loss.toFixed(4)}</td><td class=\"num\">${v.brier.toFixed(4)}</td><td class=\"num\">${(v.accuracy * 100).toFixed(1)}%</td></tr>`; }).join('');\n  return `<div class=\"table-wrap\">",
      "replace": "<td class=\"num\">${v.log_loss.toFixed(4)}</td><td class=\"num\">${(v.accuracy * 100).toFixed(1)}%</td></tr>`; }).join('');\n  return `<div class=\"table-wrap\">",
      "expect_caught_by": "test_every_held_out_figure_is_on_the_page_with_brier"
    },
    {
      "id": "nhl-heldout-leaves-out-the-market",
      "why": "the NHL's table stops asking for the market's row, so Model B is shown without the forecaster H3 compares it with",
      "find": "['Model B', 'model_b'], ['Market', 'market']], 'nhl')}",
      "replace": "['Model B', 'model_b']], 'nhl')}",
      "expect_caught_by": "test_every_held_out_figure_is_on_the_page_with_brier"
