{
  "target": "data/nba/drift_baseline.json",
  "tests": "tests/test_nba_stage65_registry.py",
  "cases": [
    {
      "id": "nba-drift-baseline-rounded",
      "why": "the baseline is copied by hand and rounded, so the drift check compares against a number no result file holds",
      "find": "\"value\": 0.5983212187245471",
      "replace": "\"value\": 0.5983",
      "expect_caught_by": "test_the_baseline_is_model_a_on_stage_61s_confirmation_seasons"
    },
    {
      "id": "nba-drift-baseline-two-sided",
      "why": "the file's level stops being the one-sided 95% the registry names, so a flag means something different from what is written down",
      "find": "\"one_sided_level\": 0.95",
      "replace": "\"one_sided_level\": 0.975",
      "expect_caught_by": "test_the_drift_rule_it_registers_is_the_one_the_baseline_file_holds"
    }
  ]
}
