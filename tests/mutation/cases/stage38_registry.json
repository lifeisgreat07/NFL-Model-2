{
  "target": "src/sports/nfl/model_lab.py",
  "tests": "tests/test_stage38_registry.py",
  "cases": [
    {
      "id": "lab-shows-a-rule-not-yet-in-force",
      "why": "a monitoring rule that is only registered shows on Model Lab as ADOPTED, so the page says live reliability is being checked before anything checks it.",
      "find": "            elif entry.get('kind') == 'monitoring_rule' and entry.get('status') != 'REGISTERED':\n",
      "replace": "            elif entry.get('kind') == 'monitoring_rule':\n",
      "expect_caught_by": "test_m1_is_registered_not_in_force_so_it_has_no_row_yet"
    },
    {
      "id": "s38-budget-loosened",
      "target": "experiments/nfl/stage38/registry.json",
      "why": "a third slot appears without the level moving, so two questions are decided at an interval that no longer holds the family's error rate.",
      "find": "   \"spends_slot\": false,\n   \"consequence\": \"No R1-R3 label changes.",
      "replace": "   \"spends_slot\": true,\n   \"consequence\": \"No R1-R3 label changes.",
      "expect_caught_by": "test_two_slots_and_the_level_they_set"
    }
  ]
}
